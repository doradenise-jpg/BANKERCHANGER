# ── Stellar Network ───────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Contract Addresses (set after deployment) ─────────────────
FACTORY_CONTRACT_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
TREASURY_ADDRESS=

# ── Oracle Keypair (keep secret — use a secrets manager in prod) ─
ORACLE_PRIVATE_KEY=SBAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
ORACLE_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Admin ─────────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
ADMIN_PRIVATE_KEY=SBAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://bankerchanger:bankerchanger@localhost:5432/bankerchanger
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes
# Optional per-token-type secrets (recommended for production). Each falls
# back to JWT_SECRET when unset — set all four to distinct values so that a
# leaked token secret can't be used to forge other token types.
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production-min-32-bytes
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production-min-32-bytes
JWT_TEMP_SECRET=your-jwt-temp-secret-change-in-production-min-32-bytes
JWT_RESET_SECRET=your-jwt-reset-secret-change-in-production-min-32-bytes
ORACLE_API_KEY=your-oracle-api-key
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_EXPORT_ROWS=1000000

# ── Indexer ───────────────────────────────────────────────────
GENESIS_LEDGER=100000
POLL_INTERVAL_MS=5000

# ── External Boxing Data API ──────────────────────────────────
BOXING_API_URL=https://api.example-boxing-data.com/v1

# ── TOTP (2FA) ────────────────────────────────────────────────
# Number of time-step windows allowed in each direction during
# verification.  0 = current step only (30 s window), which is
# the recommended setting for a financial platform.  Increase
# only to tolerate clock skew on client devices.
TOTP_WINDOW=0

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Alerting ─────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── Swagger ──────────────────────────────────────────────────
ENABLE_SWAGGER=false

# ── Email ─────────────────────────────────────────────────────
# Provider: smtp | sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@bankerchanger.app
# Required when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxx
APP_NAME=BANKERCHANGER
APP_BASE_URL=http://localhost:3001


# ── Database Backups ──────────────────────────────────────────
# PostgreSQL automatic backup configuration
# Backups are encrypted (AES-256 or GPG) and can be saved locally or uploaded off-site

# Remote storage provider: s3, gcs, rclone, none (default: auto-detected from bucket config)
REMOTE_STORAGE=s3

# Local database backup directory (for local copies)
BACKUP_DIR=/var/backups/bankerchanger
KEEP_LOCAL_BACKUP=true

# Remote upload tool: aws, rclone, gcloud, gsutil (auto-detected if unset)
# REMOTE_TOOL=aws

# AWS S3 backup storage
AWS_S3_BACKUP_BUCKET=bankerchanger-backups-prod
AWS_REGION=us-east-1
S3_BACKUP_PREFIX=db-backups

# Google Cloud Storage (GCS) backup storage (optional alternative to S3)
# GCS_BACKUP_BUCKET=bankerchanger-backups-gcs-prod
# GCS_BACKUP_PREFIX=db-backups

# rclone remote target (optional alternative for S3/GCS/B2/Azure)
# RCLONE_DEST=s3:bankerchanger-backups-prod/db-backups

# Backup retention policy (prunes off-site and local backups older than N days)
BACKUP_RETENTION_DAYS=30

# Backup encryption: aes-256 (OpenSSL), gpg, or none
BACKUP_ENCRYPTION_TYPE=aes-256
BACKUP_ENCRYPTION_ENABLED=true

# OpenSSL AES-256 encryption key configuration
# Generate with: ./backend/scripts/generate-backup-key.sh
# Store securely with restricted permissions (mode 600)
BACKUP_ENCRYPTION_KEY_FILE=/secure/backups/encryption.key
# Alternatively, set direct key via environment variable:
# BACKUP_ENCRYPTION_KEY=your-256-bit-key-here

# GPG encryption configuration (used when BACKUP_ENCRYPTION_TYPE=gpg)
# For asymmetric encryption:
# GPG_RECIPIENT=devops@bankerchanger.internal
# For symmetric AES-256 encryption:
# GPG_PASSPHRASE_FILE=/secure/backups/gpg.passphrase
# GPG_PASSPHRASE=your-strong-passphrase

# AWS Secrets Manager secret name (for AWS production environments)
BACKUP_KEY_SECRET_NAME=bankerchanger/db-backup-key

# Backup logging directory
LOG_DIR=/var/log/backups
